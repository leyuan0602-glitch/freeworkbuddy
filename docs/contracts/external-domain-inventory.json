{
  "version": 1,
  "updatedAt": "2026-09-01",
  "purpose": [
    "FreeWorkBuddy self-hosting 工作流 A/C(蓝图 §3.2、§3.4):生产代码外部域名台账 + no-egress allowlist。",
    "scripts/check-self-host-egress.mjs 扫描与本文件同一范围的字符串字面量域名;新增未登记域名 CI 失败。",
    "official-cindy 条目是 Phase 1 no-egress 的移除目标:Self-host 发行版运行时请求必须为 0;在此先如实登记。"
  ],
  "matching": {
    "exact": "host 精确命中条目。",
    "subdomain": "host 以 \".\" + allowSubdomains 条目 host 结尾时命中该条目(仅 allowSubdomains: true 的条目参与)。",
    "officialStrict": "official-cindy 母域条目 allowSubdomains: false:官方母域下新增子域必须逐个登记,防止悄悄增加官方 egress 面。"
  },
  "dispositions": {
    "official-runtime": "官方 Cindy 发行版运行时依赖;self-host 发行版的目标是请求为 0(Phase 1 no-egress)。",
    "user-configured-egress": "仅在用户显式配置后访问(BYOK provider);self-host 下是唯一允许的运行时外部流量类别。",
    "feature-scoped-egress": "随具体功能(集成/内容源/图表/资产 CDN)访问;self-host 需逐项审计是否保留。",
    "build-injected": "由构建注入的第三方端点;未配置即不访问。",
    "doc-only": "注释/文档/规范链接,运行时不发起请求。",
    "test-stub": "测试与文档桩域名,不构成真实 egress。",
    "local-only": "本机回环/开发地址/防护用例引用。",
    "needs-triage": "自动发现未分类;不允许长期停留在该类别。"
  },
